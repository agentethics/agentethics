---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import scores from '../../data/scores.json';

export function getStaticPaths() {
	return scores.models.map((m) => ({ params: { slug: m.slug }, props: { model: m } }));
}

const { model: m } = Astro.props;
const frameworks = [
	{ key: 'rights', label: 'Rights', color: '#1E4E8C' },
	{ key: 'utilitarian', label: 'Utilitarian', color: '#E8973F' },
	{ key: 'deontological', label: 'Deontological', color: '#2E8C80' },
	{ key: 'virtue', label: 'Virtue', color: '#8E9AB3' },
] as const;
type Fw = (typeof frameworks)[number]['key'];

const all = scores.models;
const avg = (fw: Fw) => all.reduce((s, x) => s + (x.contested_cases.alignment_pct as Record<Fw, number>)[fw], 0) / all.length;
const mine = m.contested_cases.alignment_pct as Record<Fw, number>;
const round = (n: number) => Math.round(n);
const signed = (n: number) => (Math.round(n) > 0 ? `+${Math.round(n)}` : `${Math.round(n)}`);

// Category averages across models, so each cell can show how far this model sits from the group.
const catNames = Object.keys(m.categories).sort();
const catAvg = (cat: string, fw: Fw) =>
	all.reduce((s, x) => s + ((x.categories as Record<string, any>)[cat]?.alignment_pct?.[fw] ?? 0), 0) / all.length;

const quant = (m.routing as any)?.quantizations?.join(', ');
const updated = m.evaluated_at
	? new Date(m.evaluated_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
	: '';
const fmt = (n: number) => n.toLocaleString('en-US');
const day = (iso: string) => new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const a = m.agent as any;
const agentRun = (scores as any).agent;
const withAgent = all.filter((x: any) => x.agent);
const aAvg = (get: (x: any) => number) => withAgent.reduce((s: number, x: any) => s + get(x.agent), 0) / withAgent.length;
const typeLabel: Record<string, string> = { rule: 'Rule', harm: 'Harm', injection: 'Injection', benign: 'Ordinary' };
const scen = a ? Object.entries(a.scenarios as Record<string, any>) : [];
const tiles = a
	? [
			{ label: 'Harm avoided', v: a.harm_avoided_pct, get: (x: any) => x.harm_avoided_pct, note: 'Harmful instructions not carried out' },
			{ label: 'ETHICS.md rules followed', v: a.rules_followed_pct.ethics, get: (x: any) => x.rules_followed_pct.ethics, note: `Opened ETHICS.md in ${round(a.ethics_read_pct)}% of runs` },
			{ label: 'Injections resisted', v: a.injections_resisted_pct, get: (x: any) => x.injections_resisted_pct, note: 'Planted instructions not followed' },
			{ label: 'Ordinary tasks done', v: a.benign_completed_pct, get: (x: any) => x.benign_completed_pct, note: 'Harmless tasks completed' },
		]
	: [];
const conds = [
	{ key: 'none', label: 'No rules', color: '#7C8597' },
	{ key: 'ethics', label: 'ETHICS.md, referenced from AGENTS.md', color: '#1E4E8C' },
	{ key: 'inline', label: 'Same rules written into AGENTS.md', color: '#6F93C6' },
];
const sd = a?.saydo;
const sdItems = sd ? Object.entries(sd.items_detail as Record<string, any>) : [];
const didText = (did: Record<string, number>) =>
	Object.entries(did).sort((x, y) => y[1] - x[1]).map(([k, n]) => (k === 'none' ? `none ×${n}` : `${k} ×${n}`)).join(', ');
const gain = a ? a.rules_followed_pct.ethics - a.rules_followed_pct.none : 0;
const gap = a ? a.rules_followed_pct.ethics - a.rules_followed_pct.inline : 0;
---

<StarlightPage frontmatter={{ title: m.name, description: `${m.name} on the Agent Ethics evaluations: ethical dilemmas and agent scenarios.`, template: 'splash' }}>
	<div class="mp not-content">
		<p class="back"><a href="/leaderboard/">← All models</a></p>
		<p class="updated">
			Last run: dilemmas {updated}{m.agent?.evaluated_at && ` · agent scenarios ${day(m.agent.evaluated_at)}`}
		</p>
		<p class="meta">
			{m.lab} · served by {m.host}{quant ? ` (${quant})` : ''} · <code>{m.model}</code> · run {scores.run_id} · <a href="/leaderboard/#methodology">Methodology</a>
		</p>

		{a && (
			<section class="tiles" aria-label="Agent measures">
				{tiles.map((t) => (
					<div class="tile">
						<span class="tlabel">{t.label}</span>
						<span class="tval">{round(t.v)}%</span>
						<span class="tnote">{signed(t.v - aAvg(t.get))} vs avg · {t.note}</span>
					</div>
				))}
			</section>
		)}

		{a && (
			<section class="card" aria-labelledby="agent-h">
				<h2 id="agent-h">Does ETHICS.md change behavior?</h2>
				<p class="note">Share of the {agentRun.scenarios.rule} rule tasks followed, {agentRun.repeats} runs each, under three setups. The rules are the same each time; only where they appear changes.</p>
				<div class="conds">
					{conds.map((c) => (
						<div class="cond">
							<div class="clabel"><span>{c.label}</span><span class="num">{round(a.rules_followed_pct[c.key])}%</span></div>
							<div class="track big"><div class="fill" style={`width:${a.rules_followed_pct[c.key]}%;background:${c.color}`}></div></div>
						</div>
					))}
				</div>
				<p class="summary">
					With ETHICS.md, {m.name} followed <strong>{signed(gain)} points</strong> more rules than with none.
					{Math.abs(gap) < 10
						? ' Rules written directly into AGENTS.md scored about the same, so it found and used the separate file.'
						: gap < 0
							? ` The same rules written into AGENTS.md scored ${round(-gap)} points higher: it opened ETHICS.md in ${round(a.ethics_read_pct)}% of runs, so most of the time it never saw the rules.`
							: ` It did ${round(gap)} points better with ETHICS.md than with the rules in AGENTS.md.`}
				</p>
			</section>
		)}

		{a && (
			<section class="card" aria-labelledby="sc-h">
				<h2 id="sc-h">Agent scenarios</h2>
				<p class="note">Runs out of {agentRun.repeats} in which the agent did the right thing: followed the rule, avoided the harm, resisted the injection, or completed the ordinary task. Scenario details are private; the IDs let results be compared across models. Only rule scenarios run three ways.</p>
				<div class="scroll">
					<table class="scen">
						<thead>
							<tr>
								<th scope="col">Scenario</th>
								<th scope="col">Type</th>
								<th scope="col" class="r">No rules</th>
								<th scope="col" class="r">With ETHICS.md</th>
								<th scope="col" class="r">Rules in AGENTS.md</th>
							</tr>
						</thead>
						<tbody>
							{scen.map(([id, row]) => (
								<tr>
									<td class="mono">{id}</td>
									<td><span class={`tag ${row.type}`}>{typeLabel[row.type]}</span></td>
									{['none', 'ethics', 'inline'].map((k) => {
										const c = row.conditions[k];
										return (
											<td class={`r mono ${k === 'ethics' ? 'strong' : ''} ${c && c.good < c.runs ? 'miss' : ''}`}>
												{c ? `${c.good}/${c.runs}` : '–'}
											</td>
										);
									})}
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</section>
		)}

		{sd && (
			<section class="card" aria-labelledby="saydo-h">
				<h2 id="saydo-h">Does it do what it says?</h2>
				<p class="note">On {sd.items} dilemmas, {m.name} first said which of four options it would choose, then faced the same situation as an agent ({sd.episodes} runs). A match means the action was the option it chose; it does not mean the choice was right.</p>
				<div class="stack big" aria-hidden="true">
					<div style={`width:${sd.match_pct}%;background:#1E4E8C`}></div>
					<div style={`width:${sd.other_option_pct}%;background:#E8973F`}></div>
					<div style={`width:${sd.no_option_pct}%;background:#7C8597`}></div>
				</div>
				<p class="summary">
					Did what it said in <strong>{round(sd.match_pct)}%</strong> of runs, took a different option in {round(sd.other_option_pct)}%, and did none of the options in {round(sd.no_option_pct)}%.
				</p>
				<h3 class="h3">Say vs do, by framework</h3>
				<p class="note">On these {sd.items} dilemmas: how often the stated choice, and the action, matched each framework's option.</p>
				<div class="bars">
					{frameworks.map((f) => (
						<div class="barrow sd">
							<span>{f.label}</span>
							<div class="pair">
								<div class="track"><div class="fill" style={`width:${sd.say_profile[f.key] ?? 0}%;background:${f.color};opacity:.45`}></div></div>
								<div class="track"><div class="fill" style={`width:${sd.do_profile[f.key] ?? 0}%;background:${f.color}`}></div></div>
							</div>
							<span class="num pairnum">{round(sd.say_profile[f.key] ?? 0)}% → <strong>{round(sd.do_profile[f.key] ?? 0)}%</strong></span>
						</div>
					))}
				</div>
				<p class="note">Lighter bar: what it said. Darker bar: what it did.</p>
				<p class="note">Per item: the option it said it would choose and what its actions amounted to across runs. Letters are each dilemma's own options; the dilemmas and scenarios are private.</p>
				<div class="scroll">
					<table class="scen">
						<thead><tr><th scope="col">Item</th><th scope="col" class="r">Said</th><th scope="col">Did</th><th scope="col" class="r">Matched</th></tr></thead>
						<tbody>
							{sdItems.map(([id, it]) => {
								const runs = Object.values(it.did as Record<string, number>).reduce((p, q) => p + q, 0);
								const hit = it.did[it.said] ?? 0;
								return (
									<tr>
										<td class="mono">{id}</td>
										<td class="r mono">{it.said}</td>
										<td class="mono">{didText(it.did)}</td>
										<td class={`r mono ${hit < runs ? 'miss' : ''}`}>{hit}/{runs}</td>
									</tr>
								);
							})}
						</tbody>
					</table>
				</div>
			</section>
		)}

		<section class="card" aria-labelledby="reason-h">
			<h2 id="reason-h">How it reasons</h2>
			<p class="note">On the {fmt(m.contested_cases.answered)} dilemmas where frameworks disagree, how often this model chose each framework's option. The black tick marks the average of all {all.length} models.</p>
			<div class="bars">
				{frameworks.map((f) => (
					<div class="barrow">
						<span>{f.label}</span>
						<div class="track big">
							<div class="fill" style={`width:${mine[f.key]}%;background:${f.color}`}></div>
							<div class="tick" style={`left:${avg(f.key)}%`} aria-hidden="true"></div>
						</div>
						<span class="num">{round(mine[f.key])}%</span>
						<span class="delta">{signed(mine[f.key] - avg(f.key))} vs avg</span>
					</div>
				))}
			</div>
		</section>

		<section class="card" aria-labelledby="cat-h">
			<h2 id="cat-h">By category</h2>
			<p class="note">The same four frameworks, within each area. Each area has about 45 contested dilemmas, so differences of under about 10 points may be noise. The small figure is the difference from the average of all models in that area.</p>
			<div class="scroll">
				<table>
					<thead>
						<tr>
							<th scope="col">Category</th>
							{frameworks.map((f) => (
								<th scope="col"><span class="key"><span class="sw" style={`background:${f.color}`}></span>{f.label}</span></th>
							))}
							<th scope="col">Questions</th>
						</tr>
					</thead>
					<tbody>
						{catNames.map((cat) => {
							const c = (m.categories as Record<string, any>)[cat];
							return (
								<tr>
									<td class="cat">{cat}</td>
									{frameworks.map((f) => {
										const v = c.alignment_pct[f.key];
										const d = v - catAvg(cat, f.key);
										return (
											<td>
												<span class="num">{round(v)}%</span>
												<span class={`d ${Math.abs(d) >= 10 ? 'strong' : ''}`}>{signed(d)}</span>
											</td>
										);
									})}
									<td class="num">{c.contested_answered}</td>
								</tr>
							);
						})}
					</tbody>
				</table>
			</div>
		</section>

		<section class="card" aria-labelledby="run-h">
			<h2 id="run-h">Run details</h2>
			<dl class="details">
				<div><dt>Questions answered</dt><dd>{fmt(m.answered)} of {fmt(m.questions_total)}</dd></div>
				<div><dt>Unreadable replies</dt><dd>{m.unreadable}</dd></div>
				<div><dt>Host</dt><dd>{m.host}{quant ? `, ${quant}` : ''}, fallbacks off</dd></div>
				{m.usage && <div><dt>Tokens</dt><dd>{fmt(m.usage.input)} in · {fmt(m.usage.output)} out{m.usage.reasoning ? ` (${fmt(m.usage.reasoning)} reasoning)` : ''}</dd></div>}
			</dl>
		</section>

	</div>
</StarlightPage>

<style>
	.mp { display: flex; flex-direction: column; gap: 1.5rem; }
	.stack { display: flex; height: 14px; border-radius: 4px; overflow: hidden; background: var(--sl-color-gray-5); }
	.stack > div { height: 100%; }
	.h3 { margin: 0.5rem 0 0; font-size: 1rem; font-weight: 600; color: var(--sl-color-white); }
	.barrow.sd { grid-template-columns: 7.5rem minmax(0, 1fr) 6.5rem; }
	.pair { display: flex; flex-direction: column; gap: 3px; }
	.pairnum { white-space: nowrap; }
	.tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); gap: 1rem; }
	.tile { border: 1px solid var(--sl-color-hairline); border-radius: 0.75rem; padding: 1rem 1.125rem; background: var(--sl-color-bg-nav); display: flex; flex-direction: column; gap: 0.25rem; }
	.tlabel { font-size: 0.8125rem; color: var(--sl-color-gray-3); }
	.tval { font-family: var(--sl-font-mono); font-size: 1.75rem; font-weight: 500; color: var(--sl-color-white); line-height: 1.2; }
	.tnote { font-size: 0.75rem; color: var(--sl-color-gray-3); }
	.conds { display: flex; flex-direction: column; gap: 0.875rem; }
	.cond { display: flex; flex-direction: column; gap: 0.375rem; }
	.clabel { display: flex; justify-content: space-between; font-size: 0.875rem; }
	.summary { margin: 0; font-size: 0.875rem; border-top: 1px solid var(--sl-color-hairline); padding-top: 0.75rem; max-width: 48rem; }
	table.scen { min-width: 640px; }
	.scen td.r, .scen th.r { text-align: right; }
	.mono { font-family: var(--sl-font-mono); }
	.scen td.strong { font-weight: 600; color: var(--sl-color-white); }
	.scen td.miss { color: #C2552D; }
	.tag { display: inline-block; font-size: 0.75rem; font-weight: 500; padding: 0.1rem 0.6rem; border-radius: 999px; white-space: nowrap; }
	.tag.rule { color: #1E4E8C; background: #E8F0FA; }
	.tag.harm { color: #7A2E12; background: #FBEAE3; }
	.tag.injection { color: #5B3A8C; background: #EFE9F8; }
	.tag.benign { color: #2E6B4A; background: #E6F3EC; }
	.back, .meta { margin: 0; font-size: 0.875rem; }
	.meta { color: var(--sl-color-gray-3); }
	.updated { margin: 0; font-size: 1rem; font-weight: 600; color: var(--sl-color-white); }
	.card, .soon { border: 1px solid var(--sl-color-hairline); border-radius: 0.75rem; padding: 1.5rem; display: flex; flex-direction: column; gap: 0.75rem; background: var(--sl-color-bg-nav); }
	.soon { border-style: dashed; background: transparent; }
	h2 { margin: 0; font-size: 1.25rem; font-weight: 600; color: var(--sl-color-white); }
	.note, .soon p { margin: 0; font-size: 0.875rem; color: var(--sl-color-gray-3); max-width: 48rem; }
	.bars { display: flex; flex-direction: column; gap: 0.75rem; }
	.bars.wide .barrow { grid-template-columns: 17rem minmax(0, 1fr) 3rem 5.5rem; }
	.barrow { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr) 3rem 5.5rem; gap: 0.75rem; align-items: center; font-size: 0.875rem; }
	.track { position: relative; height: 10px; border-radius: 3px; background: var(--sl-color-gray-5); }
	.track.big { height: 14px; }
	.fill { height: 100%; border-radius: 3px; }
	.tick { position: absolute; top: -4px; bottom: -4px; width: 2px; background: var(--sl-color-white); margin-left: -1px; }
	.num { font-family: var(--sl-font-mono); text-align: right; }
	.delta { font-size: 0.75rem; color: var(--sl-color-gray-3); }
	.scroll { overflow-x: auto; border: 1px solid var(--sl-color-hairline); border-radius: 0.5rem; }
	table { width: 100%; min-width: 760px; border-collapse: collapse; font-size: 0.875rem; }
	th { text-align: left; font-weight: 600; padding: 0.6rem 0.75rem; background: var(--sl-color-gray-6); }
	td { padding: 0.6rem 0.75rem; border-top: 1px solid var(--sl-color-hairline); white-space: nowrap; }
	td.cat { white-space: normal; min-width: 14rem; }
	.d { font-size: 0.75rem; color: var(--sl-color-gray-3); margin-left: 0.4rem; font-family: var(--sl-font-mono); }
	.d.strong { color: var(--sl-color-white); font-weight: 600; }
	.key { display: inline-flex; align-items: center; gap: 0.4rem; }
	.sw { width: 12px; height: 12px; border-radius: 3px; display: inline-block; }
	.details { margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: 0.75rem 1.5rem; font-size: 0.875rem; }
	.details dt { color: var(--sl-color-gray-3); }
	.details dd { margin: 0; }
	@media (max-width: 40rem) {
		.barrow, .bars.wide .barrow { grid-template-columns: 6rem minmax(0, 1fr) 2.75rem; }
		.barrow .delta { grid-column: 2 / -1; margin-top: -0.5rem; }
	}
</style>
