---
import scores from '../data/scores.json';

const frameworks = [
	{ key: 'rights', label: 'Rights', color: '#1E4E8C' },
	{ key: 'utilitarian', label: 'Utilitarian', color: '#E8973F' },
	{ key: 'deontological', label: 'Deontological', color: '#2E8C80' },
	{ key: 'virtue', label: 'Virtue', color: '#8E9AB3' },
];
const models = scores.models as any[];
const total = models[0]?.questions_total ?? 0;
const day = (iso: string) => new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
// Each suite's last run: when its most recent model evaluation finished.
const dilemmasRun = scores.dilemmas_evaluated_at ?? scores.generated_at;
const agent = scores.agent as any;
const agentRun = agent?.evaluated_at;
const nScenarios = agent ? Object.values(agent.scenarios as Record<string, number>).reduce((a, b) => a + b, 0) : 0;
const conditions = [
	{ key: 'none', label: 'No rules', color: 'var(--c-none)' },
	{ key: 'ethics', label: 'With ETHICS.md', color: '#1E4E8C' },
	{ key: 'inline', label: 'Same rules in AGENTS.md', color: '#6F93C6' },
];
// Each measure with no rules and with an ETHICS.md. Rule tasks use their own ETHICS.md;
// the other tasks use the one general company file.
const measures = [
	{ key: 'rules', label: 'Rules followed', short: 'Rules', none: (m: any) => m.agent.rules_followed_pct.none, with: (m: any) => m.agent.rules_followed_pct.ethics },
	{ key: 'harm', label: 'Harm avoided', short: 'Harm', none: (m: any) => m.general?.none.harm_avoided_pct, with: (m: any) => m.general?.ethics.harm_avoided_pct },
	{ key: 'injection', label: 'Injections resisted', short: 'Injections', none: (m: any) => m.general?.none.injections_resisted_pct, with: (m: any) => m.general?.ethics.injections_resisted_pct },
	{ key: 'tasks', label: 'Ordinary tasks done', short: 'Tasks', none: (m: any) => m.general?.none.benign_completed_pct, with: (m: any) => m.general?.ethics.benign_completed_pct },
	{ key: 'said', label: 'Did what it said', short: 'Said', none: (m: any) => m.general?.none.saydo_match_pct, with: (m: any) => m.general?.ethics.saydo_match_pct },
	{ key: 'breaking', label: 'Rule-breaking actions', short: 'Rule-breaking', lower: true, none: (m: any) => m.general?.none.rule_breaking_pct, with: (m: any) => m.general?.ethics.rule_breaking_pct },
];
const pct = (n: number) => `${Math.round(n)}%`;
---

<div class="lb not-content">
	{!scores.complete && (
		<p class="banner" role="note">
			<strong>Partial results.</strong> Models have answered different numbers of the {total.toLocaleString('en-US')} questions (see the Answered column). Compare with care until the run is finished.
		</p>
	)}

	<p class="updated">
		Last run: dilemmas <time datetime={dilemmasRun.slice(0, 10)}>{day(dilemmasRun)}</time>{agentRun && <> · agent scenarios <time datetime={agentRun.slice(0, 10)}>{day(agentRun)}</time></>}
	</p>
	<p class="meta">
		Evals v{scores.evals_version} · {models.length} models · {nScenarios ? `${nScenarios} agent scenarios · ` : ''}{total.toLocaleString('en-US')} dilemmas · dates in UTC · <a href="#methodology">Methodology</a> · <a href="#what-the-scores-mean">What the scores mean</a>
	</p>

	{agent && (
		<section class="card" aria-labelledby="uplift-h">
			<h2 id="uplift-h">Does ETHICS.md change behavior?</h2>
			<p class="note">Share of the {agent.scenarios.rule} rule tasks each model followed, run {agent.repeats} times each. The rules are the same each time; only where they appear changes.</p>
			<div class="legend">
				{conditions.map((c) => <span class="key"><span class="sw" style={`background:${c.color}`}></span>{c.label}</span>)}
			</div>
			<div class="uplift">
				{models.filter((m) => m.agent).map((m) => (
					<div class="urow">
						<a class="uname" href={`/leaderboard/${m.slug}/`}>{m.name}</a>
						<div class="ubars">
							{conditions.map((c) => (
								<div class="track" title={`${c.label}: ${pct(m.agent.rules_followed_pct[c.key])}`}>
									<div class="fill" style={`width:${m.agent.rules_followed_pct[c.key]}%;background:${c.color}`}></div>
								</div>
							))}
						</div>
						<span class="unum">
							<span>{pct(m.agent.rules_followed_pct.none)} → <strong>{pct(m.agent.rules_followed_pct.ethics)}</strong></span>
							<span class="usub">AGENTS.md {pct(m.agent.rules_followed_pct.inline)}</span>
						</span>
					</div>
				))}
			</div>
		</section>
	)}

	{agent && (
		<section class="card" aria-labelledby="measure-h">
			<div class="head">
				<div>
					<h2 id="measure-h">Results by measure</h2>
					<p class="note">Each cell shows the result with no rules → with an ETHICS.md, which <code>AGENTS.md</code> points to. Rule tasks use an ETHICS.md holding that task's rule. Every other task uses one general company ETHICS.md, the same for all of them. Rule-breaking actions: lower is better. Every other column: higher is better. Sorting uses the results with ETHICS.md.</p>
				</div>
				<div class="sort" role="group" aria-label="Sort agent results" data-table="measure-table">
					<span class="sort-label">Sort by</span>
					<button type="button" class="pill" data-sort="default" aria-pressed="true">Default</button>
					{measures.map((c) => <button type="button" class="pill" data-sort={c.key} data-lower={c.lower ? '1' : undefined} aria-pressed="false">{c.short}</button>)}
				</div>
			</div>
			<div class="legend">
				<span class="key"><span class="sw" style="background:var(--c-none)"></span>No rules</span>
				<span class="key"><span class="sw" style="background:#1E4E8C"></span>With ETHICS.md</span>
			</div>
			<div class="scroll">
				<table id="measure-table" class="measures">
					<thead>
						<tr>
							<th scope="col">Model</th>
							{measures.map((c) => <th scope="col">{c.label}</th>)}
							<th scope="col">Opened ETHICS.md</th>
						</tr>
					</thead>
					<tbody>
						{models.filter((m) => m.agent).map((m, i) => (
							<tr data-default={i} {...Object.fromEntries(measures.map((c) => [`data-${c.key}`, c.with(m) ?? -1]))}>
								<td class="model">
									<a class="mlink" href={`/leaderboard/${m.slug}/`}><strong>{m.name}</strong></a>
									<span class="sub">{m.lab}</span>
								</td>
								{measures.map((c) => {
									const n = c.none(m), w = c.with(m);
									return (
										<td>
											{w == null ? <span class="num">–</span> : (
												<div class="pair" title={`No rules ${pct(n)} · with ETHICS.md ${pct(w)}`}>
													<div class="bars">
														<div class="track thin"><div class="fill" style={`width:${n}%;background:var(--c-none)`}></div></div>
														<div class="track thin"><div class="fill" style={`width:${w}%;background:#1E4E8C`}></div></div>
													</div>
													<span class="num">{pct(n)} → <strong>{pct(w)}</strong></span>
												</div>
											)}
										</td>
									);
								})}
								<td class="num">{m.general ? pct(m.general.ethics.ethics_read_pct) : '–'}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>
	)}

	{models.some((m) => m.agent?.saydo) && (
		<section class="card" aria-labelledby="saydo-h">
			<h2 id="saydo-h">Do models do what they say?</h2>
			<p class="note">Each model answered a dilemma, then faced the same situation as an agent. The bar shows how often its action was the option it said it would choose, how often it took a different option, and how often it did none of them. A match means its stated choices predict its behavior; it does not mean the choice was right.</p>
			<div class="legend">
				<span class="key"><span class="sw" style="background:#1E4E8C"></span>Did what it said</span>
				<span class="key"><span class="sw" style="background:#E8973F"></span>Took a different option</span>
				<span class="key"><span class="sw" style="background:var(--c-none)"></span>None of the options</span>
			</div>
			<div class="uplift">
				{models.filter((m) => m.agent?.saydo).map((m) => {
					const sd = m.agent.saydo;
					return (
						<div class="urow">
							<a class="uname" href={`/leaderboard/${m.slug}/#saydo-h`}>{m.name}</a>
							<div class="stack" title={`${pct(sd.match_pct)} matched · ${pct(sd.other_option_pct)} different option · ${pct(sd.no_option_pct)} none`}>
								<div style={`width:${sd.match_pct}%;background:#1E4E8C`}></div>
								<div style={`width:${sd.other_option_pct}%;background:#E8973F`}></div>
								<div style={`width:${sd.no_option_pct}%;background:var(--c-none)`}></div>
							</div>
							<span class="unum"><span><strong>{pct(sd.match_pct)}</strong> match</span><span class="usub">{sd.items} dilemmas × {Math.round(sd.episodes / sd.items)} {Math.round(sd.episodes / sd.items) === 1 ? 'run' : 'runs'}</span></span>
						</div>
					);
				})}
			</div>
		</section>
	)}

	<section class="card" aria-labelledby="reason-h">
		<div class="head">
			<div>
				<h2 id="reason-h">How models reason</h2>
				<p class="note">On dilemmas where ethical frameworks disagree, how often each model chose the option each framework favors. Frameworks often share an answer, so a row does not add to 100. No profile is better than another. Select a model for its breakdown by category.</p>
			</div>
			<div class="sort" role="group" aria-label="Sort models by framework" data-table="reason-table">
				<span class="sort-label">Sort by</span>
				<button type="button" class="pill" data-sort="default" aria-pressed="true">Default</button>
				{frameworks.map((f) => <button type="button" class="pill" data-sort={f.key} aria-pressed="false">{f.label}</button>)}
			</div>
		</div>
		<div class="scroll">
			<table id="reason-table">
				<thead>
					<tr>
						<th scope="col">Model</th>
						{frameworks.map((f) => (
							<th scope="col"><span class="key"><span class="sw" style={`background:${f.color}`}></span>{f.label}</span></th>
						))}
						{!scores.complete && <th scope="col">Answered</th>}
					</tr>
				</thead>
				<tbody>
					{models.map((m, i) => (
						<tr data-default={i} {...Object.fromEntries(frameworks.map((f) => [`data-${f.key}`, m.contested_cases.alignment_pct[f.key]]))}>
							<td class="model">
								<a class="mlink" href={`/leaderboard/${m.slug}/`}><strong>{m.name}</strong></a>
								<span class="sub">{m.lab} · served by {m.host ?? 'unknown'}</span>
							</td>
							{frameworks.map((f) => {
								const v = m.contested_cases.alignment_pct[f.key];
								return (
									<td>
										<div class="cell">
											<div class="track"><div class="fill" style={`width:${v}%;background:${f.color}`}></div></div>
											<span class="num">{pct(v)}</span>
										</div>
									</td>
								);
							})}
							{!scores.complete && <td class="num">{m.answered.toLocaleString('en-US')}</td>}
						</tr>
					))}
				</tbody>
			</table>
		</div>
	</section>
</div>

<script>
	// Sort a table by a column, highest first; Default restores the original order.
	document.querySelectorAll<HTMLElement>('.sort[data-table]').forEach((group) => {
		const body = document.querySelector(`#${group.dataset.table} tbody`);
		group.addEventListener('click', (e) => {
			const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-sort]');
			if (!btn || !body) return;
			const key = btn.dataset.sort!;
			const rows = [...body.querySelectorAll<HTMLTableRowElement>('tr')];
			rows.sort((a, b) =>
				key === 'default'
					? Number(a.dataset.default) - Number(b.dataset.default)
					: (btn.dataset.lower ? Number(a.dataset[key]) - Number(b.dataset[key]) : Number(b.dataset[key]) - Number(a.dataset[key])) ||
						Number(a.dataset.default) - Number(b.dataset.default),
			);
			body.append(...rows);
			group.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
		});
	});
</script>

<style>
	.lb { --c-none: #7C8597; display: flex; flex-direction: column; gap: 1.5rem; }
	.banner { margin: 0; padding: 0.75rem 1rem; border-radius: 0.5rem; background: #FFF4E0; color: #6B4205; border: 1px solid #F0D9AE; font-size: 0.875rem; }
	.updated { margin: 0; font-size: 1rem; font-weight: 600; color: var(--sl-color-white); }
	.meta { margin: -1rem 0 0; color: var(--sl-color-gray-3); font-size: 0.875rem; }
	.card { border: 1px solid var(--sl-color-hairline); border-radius: 0.75rem; padding: 1.5rem; display: flex; flex-direction: column; gap: 0.875rem; background: var(--sl-color-bg-nav); }
	.head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 0.75rem 1.5rem; }
	.head > div:first-child { display: flex; flex-direction: column; gap: 0.25rem; max-width: 48rem; }
	h2 { margin: 0; font-size: 1.25rem; font-weight: 600; color: var(--sl-color-white); }
	.note { margin: 0; font-size: 0.875rem; color: var(--sl-color-gray-3); max-width: 48rem; }
	.legend { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; font-size: 0.8125rem; }
	.key { display: inline-flex; align-items: center; gap: 0.4rem; }
	.sw { width: 12px; height: 12px; border-radius: 3px; display: inline-block; }

	.uplift { display: flex; flex-direction: column; gap: 0.875rem; }
	.urow { display: grid; grid-template-columns: 10rem minmax(0, 1fr) 9.5rem; align-items: center; gap: 0.75rem; }
	.uname { font-size: 0.875rem; font-weight: 600; color: var(--sl-color-white); text-decoration: none; }
	.uname:hover { text-decoration: underline; }
	.ubars { display: flex; flex-direction: column; gap: 3px; }
	.unum { font-family: var(--sl-font-mono); font-size: 0.8125rem; text-align: right; display: flex; flex-direction: column; line-height: 1.3; }
	.usub { font-size: 0.75rem; color: var(--sl-color-gray-3); }

	.stack { display: flex; height: 14px; border-radius: 3px; overflow: hidden; background: var(--sl-color-gray-5); }
	.stack > div { height: 100%; }
	.sort { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
	.sort-label { font-size: 0.875rem; color: var(--sl-color-gray-3); margin-right: 0.25rem; }
	.pill { font: inherit; font-size: 0.875rem; padding: 0.35rem 0.9rem; border-radius: 999px; border: 1px solid var(--sl-color-gray-5); background: transparent; color: var(--sl-color-white); cursor: pointer; }
	.pill:hover { border-color: var(--sl-color-gray-3); }
	.pill[aria-pressed='true'] { background: var(--sl-color-white); color: var(--sl-color-black); border-color: var(--sl-color-white); }
	.pill:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }

	.scroll { overflow-x: auto; border: 1px solid var(--sl-color-hairline); border-radius: 0.5rem; }
	table { width: 100%; min-width: 900px; border-collapse: collapse; font-size: 0.875rem; }
	th { text-align: left; font-weight: 600; padding: 0.75rem; background: var(--sl-color-gray-6); }
	td { padding: 0.75rem; border-top: 1px solid var(--sl-color-hairline); min-width: 140px; }
	td.model { min-width: 190px; }
	.model strong { display: block; color: var(--sl-color-white); }
	.mlink { text-decoration: none; }
	.mlink:hover strong { text-decoration: underline; }
	.sub { font-size: 0.75rem; color: var(--sl-color-gray-3); }
	.cell { display: grid; grid-template-columns: minmax(0, 1fr) 3rem; gap: 0.5rem; align-items: center; }
	.track { height: 10px; border-radius: 3px; background: var(--sl-color-gray-5); }
	.fill { height: 10px; border-radius: 3px; }
	.pair { display: flex; flex-direction: column; gap: 0.35rem; }
	.bars { display: flex; flex-direction: column; gap: 2px; }
	.track.thin, .track.thin .fill { height: 6px; }
	.pair .num { white-space: nowrap; font-size: 0.8125rem; text-align: left; }
	.num { font-family: var(--sl-font-mono); text-align: right; }

	@media (max-width: 40rem) {
		.urow { grid-template-columns: minmax(0, 1fr) auto; }
		.ubars { grid-column: 1 / -1; grid-row: 2; }
	}
</style>
